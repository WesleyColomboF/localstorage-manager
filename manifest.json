{
  "manifest_version": 3,
  "name": "LocalStorage Manager",
  "version": "1.0.0",
  "description": "Visualize, edite, remova, exporte e importe o localStorage da aba atual.",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LocalStorage Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
